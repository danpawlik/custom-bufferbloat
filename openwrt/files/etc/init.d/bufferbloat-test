#!/bin/sh /etc/rc.common
# OpenWrt procd init for bufferbloat-test

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/bufferbloat-test

start_service() {
	local listen max_concurrent download_streams upload_streams lock_ttl value
	config_load bufferbloat-test
	config_get listen main listen ':8080'
	config_get max_concurrent main max_concurrent 1
	config_get download_streams main download_streams 4
	config_get upload_streams main upload_streams 2
	config_get lock_ttl main lock_ttl 90
	for value in "$max_concurrent" "$download_streams" "$upload_streams" "$lock_ttl"; do
		case "$value" in
			''|*[!0-9]*|0*) echo 'bufferbloat-test: counts and lock_ttl must be positive integers without leading zeros' >&2; return 1 ;;
		esac
	done

	procd_open_instance
	procd_set_param command "$PROG" -listen "$listen" \
		-max-concurrent "$max_concurrent" -download-streams "$download_streams" \
		-upload-streams "$upload_streams" -lock-ttl "${lock_ttl}s"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'bufferbloat-test'
}
