#!/bin/sh /etc/rc.common
# OpenWrt procd init for bufferbloat-test

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/bufferbloat-test
LISTEN=":8080"

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -listen "$LISTEN" -max-concurrent 1
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
